{
  "openapi": "3.1.0",
  "info": {
    "title": "VetSync API",
    "version": "1.0.0",
    "description": "Demostración local. Fechas con zona; correos simulados. Sin autenticación ni paginación."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3010/api"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Consultar salud de BD",
        "responses": {
          "200": {
            "description": "Operación correcta",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Solicitud inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Referencia o ruta inexistente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Cita en conflicto",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Carga excesiva",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Se requiere JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Error interno",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/config": {
      "get": {
        "summary": "Configuración de presentación",
        "responses": {
          "200": {
            "description": "Operación correcta",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "timeZone": {
                      "type": "string"
                    },
                    "reminderHours": {
                      "type": "number"
                    },
                    "bookingHours": {
                      "type": "object",
                      "properties": {
                        "opensAt": {
                          "const": "10:00"
                        },
                        "closesAt": {
                          "const": "18:00"
                        },
                        "slotMinutes": {
                          "const": 30
                        }
                      },
                      "required": [
                        "opensAt",
                        "closesAt",
                        "slotMinutes"
                      ],
